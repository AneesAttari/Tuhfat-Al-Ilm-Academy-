# -----------------------------------------------------------------------------
# TUHFAT AL-ILM ACADEMY - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to '.env' in your production server environment (Hostinger/VPS)
# Do NOT commit '.env' to git source control!
# -----------------------------------------------------------------------------

# --- Server & Port Configuration ---
NODE_ENV="production"
PORT=3000
APP_URL="https://yourcustomdomain.com"

# --- Database Configuration (Hostinger MySQL / MariaDB / Supabase) ---
# When deployed on Hostinger, fill these details to connect to Hostinger MySQL / MariaDB.
# If these variables are omitted, the app will safely fall back to local SQLite storage.
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="u123456789_tuhfat"
MYSQL_PASSWORD="YourSecureDatabasePassword123!"
MYSQL_DATABASE="u123456789_tuhfat_db"

# Or alternative single connection URI string for Supabase / PostgreSQL / MySQL:
# DATABASE_URL="mysql://u123456789_tuhfat:YourPassword@localhost:3306/u123456789_tuhfat_db"

# --- SMTP Email Notifications Configuration ---
# Required for real automated email notifications to tuhfatalilmacademy@gmail.com
# Obtain these from Hostinger Email, Gmail App Password, or SendGrid/Mailgun.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="admissions@yourcustomdomain.com"
SMTP_PASS="YourEmailAccountPassword123!"
SMTP_FROM="Tuhfat Al-Ilm Academy Admissions <admissions@yourcustomdomain.com>"
ACADEMY_ADMIN_EMAIL="tuhfatalilmacademy@gmail.com"

# --- Admin Initial Credentials ---
ADMIN_INITIAL_PASSWORD="Admin@Tuhfat2026!"

# --- Optional Google OAuth Credentials ---
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# --- Optional Gemini API Key ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

