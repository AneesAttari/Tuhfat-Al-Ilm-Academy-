# =============================================================================
# TUHFAT AL-ILM ACADEMY - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to '.env' on your Hostinger Node.js Web App environment.
# DO NOT commit real passwords or API secrets to git version control.
# =============================================================================

# --- Server & Core Application Settings ---
NODE_ENV=production
PORT=3000
APP_URL=https://YOUR-DOMAIN

# --- Authorized Administrator Email Accounts (Strictly 2 Accounts) ---
# 1. Your official administrator email account
ADMIN_EMAIL=YOUR_OFFICIAL_EMAIL
# 2. Academy admissions administrator email account
ACADEMY_ADMIN_EMAIL=tuhfatalilmacademy@gmail.com

# --- Hostinger MySQL / MariaDB Database Configuration ---
# Create database and user via Hostinger hPanel -> Databases -> MySQL Databases
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=YOUR_HOSTINGER_MYSQL_USER
MYSQL_PASSWORD=YOUR_HOSTINGER_MYSQL_PASSWORD
MYSQL_DATABASE=YOUR_HOSTINGER_MYSQL_DATABASE

# Optional: Direct connection URI string (alternative)
# DATABASE_URL=mysql://YOUR_HOSTINGER_MYSQL_USER:YOUR_HOSTINGER_MYSQL_PASSWORD@localhost:3306/YOUR_HOSTINGER_MYSQL_DATABASE

# --- Administrator Initial Credentials ---
# Password used to initialize administrator account on first login
ADMIN_INITIAL_PASSWORD=YOUR_UNIQUE_STRONG_PASSWORD

# --- Google OAuth Credentials (For Admin 'Continue with Google') ---
# Create an OAuth 2.0 Web Client ID in Google Cloud Console:
# Authorized JavaScript Origins: https://YOUR-DOMAIN
# Authorized Redirect URIs: https://YOUR-DOMAIN, https://YOUR-DOMAIN/admin/login
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# --- SMTP Email Notifications (Hostinger Webmail or SMTP Gateway) ---
# Notifications for new trial bookings are dispatched to the administrators.
# The website operates properly even if SMTP is not configured.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_HOSTINGER_EMAIL
SMTP_PASS=YOUR_HOSTINGER_EMAIL_PASSWORD
SMTP_FROM=Tuhfat Al-Ilm Academy Admissions <YOUR_HOSTINGER_EMAIL>
